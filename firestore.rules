rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // This compatibility ruleset preserves the current application's behavior.
    // The app does not use Firebase Authentication, so these collections must be
    // public for the current login and session flows to keep working.
    match /users/{userId} {
      allow read, create, update, delete: if true;
    }

    match /chapcaSessions/{sessionId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    match /salesSessions/{sessionId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    match /aimSessions/{sessionId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    match /captchaSettings/{userId} {
      allow read, create, update, delete: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
