rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // All access goes through the Next.js server with Firebase Admin SDK.
    // Normal users have no Firebase Auth account; authorization is enforced
    // by the server's HttpOnly sessions. Direct client access is disabled.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
